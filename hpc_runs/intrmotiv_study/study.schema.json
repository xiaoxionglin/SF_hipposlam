{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intrmotiv/study/v1",
  "title": "IntrMotiv Study Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_version", "study_id", "description", "training", "bases", "factors", "seeds"],
  "properties": {
    "schema": {"const": "intrmotiv/study/v1"},
    "workflow_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "study_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1},
    "expected_runs": {"type": "integer", "minimum": 1},
    "metadata": {"$ref": "#/$defs/metadata"},
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_name", "workspace_root", "output_root", "run_name_template", "common_args"],
      "properties": {
        "mode": {"enum": ["sample_factory", "supplemental_args"]},
        "batch_name": {"$ref": "#/$defs/identifier"},
        "workspace_root": {"type": "string", "pattern": "^/"},
        "output_root": {"type": "string", "pattern": "^/"},
        "run_name_template": {"type": "string", "minLength": 1},
        "condition_name_template": {"type": "string", "minLength": 1},
        "seed_arg": {"type": "string", "minLength": 1},
        "common_args": {"$ref": "#/$defs/args"}
      }
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "label": {"type": "string", "minLength": 1},
          "args": {"$ref": "#/$defs/args"},
          "metadata": {"$ref": "#/$defs/metadata"}
        }
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "levels"],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": {"$ref": "#/$defs/scalar"},
                "label": {"type": "string", "minLength": 1},
                "args": {"$ref": "#/$defs/args"},
                "metadata": {"$ref": "#/$defs/metadata"}
              }
            }
          }
        }
      }
    },
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "analysis": {"type": "object"},
    "telemetry": {"type": "object"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "scalar": {"type": ["string", "integer", "number", "boolean"]},
    "metadata": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}},
    "args": {"type": "array", "items": {"type": "string", "pattern": "^--"}}
  }
}

